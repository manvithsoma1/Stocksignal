# ── Production environment variables ─────────────────────────────
# Copy this to .env and fill in real values (never commit .env)

# PostgreSQL connection string (from Render / Supabase / Neon)
DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<db>?sslmode=require

# Runtime environment
APP_ENV=production
DB_SSLMODE=require

# Connection pool (tune to your hosting tier)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Multi-tenancy
ENABLE_TENANT_ISOLATION=true
AUTH_HEADER_NAME=X-Organization-ID
